{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-worker",
	"main": "function/_worker.ts",
	"compatibility_date": "2026-01-22",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "society_db",
			"database_id": "c60e44dd-d289-4bd2-9141-20d5e14c8e22",
			"remote": true
		}
	]
	// 在 Cloudflare Dashboard 中配置以下环境变量:
	// RESEND_API_KEY: 你的 Resend API Key
	// B2_ENDPOINT, B2_KEY_ID, B2_APPLICATION_KEY, B2_BUCKET_NAME, JWT_SECRET
